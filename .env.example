# =============================================================================
# AIRP — .env.example
# =============================================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked REQUIRED
#   3. Never commit .env — it is in .gitignore
#   4. This file (.env.example) IS committed — it documents all variables
#   5. backend/tests/unit/test_env_example_sync.py machine-checks that every
#      backend.config.Settings field has a matching KEY= line here — if you
#      add a new Settings field, add it here too or that test will fail.
#
# SECTIONS:
#   1. Application
#   2. LLM Provider (Groq / Anthropic)
#   3. Observability (LangSmith)
#   4. Database (PostgreSQL — Neon)
#   5. Cache (Redis — Upstash)
#   6. Vector Store (ChromaDB)
#   7. Authentication
#   8. External Data APIs
#   9. Feature Flags
#
# Frontend (Vite) variables live in frontend/.env.example, not here — they
# are a separate build (a different process, a different .env file) and
# duplicating them here has previously drifted out of sync with the real
# variable names the frontend code actually reads.
# =============================================================================


# ── 1. Application ────────────────────────────────────────────────────────────

# Runtime environment. Controls logging verbosity, error detail, and
# whether debug endpoints are exposed.
# Type    : string
# Values  : development | test | staging | production
# Default : development
# Required: yes
ENVIRONMENT=development

# Python logging level for the FastAPI application.
# Type    : string
# Values  : DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default : INFO (use DEBUG locally for verbose output)
# Required: no
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to make cross-origin requests.
# Add your Vercel preview URL here when testing deployed frontend.
# frontend/vite.config.ts's dev server runs on port 3000 (not Vite's
# 5173 default) -- see server.port there. docker-compose.yml (T-073)
# overrides this to http://localhost:3000 automatically for the api
# container; this default matters for running the backend WITHOUT
# Docker against a `npm run dev` frontend on the host.
# Type    : string (comma-separated URLs, no trailing slashes)
# Example : http://localhost:3000,https://airp.vercel.app
# Required: yes
CORS_ORIGINS=http://localhost:3000

# Secret key used to sign JWT tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production -- backend/config.py refuses to start with the
# placeholder value below when ENVIRONMENT=production.
# Type    : string (64-char hex)
# Required: yes
SECRET_KEY=replace-with-64-char-hex-secret-generated-locally

# JWT token expiry in minutes.
# Type    : integer
# Default : 60 (1 hour)
# Required: no
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ── 2. LLM Provider (Groq / Anthropic) ───────────────────────────────────────

# Switches which provider every agent's LLM call actually uses.
# Type    : string
# Values  : groq | anthropic
# Default : groq
# Required: no
LLM_PROVIDER=groq

# Groq API key (free tier — used for development).
# Get it at: https://console.groq.com/keys
# Type    : string
# Required: yes, when LLM_PROVIDER=groq
GROQ_API_KEY=gsk_replace-with-your-groq-key

# Groq model. Must match a currently-served Groq model id -- Groq
# periodically decommissions older ids without notice (the entire
# llama3-*-8192 AND llama-3.x families, including llama-3.3-70b-versatile
# and llama-3.1-8b-instant, were retired as of 2026-08-19). If every LLM
# call in the pipeline starts 404ing with model_not_found, check
# GET https://api.groq.com/openai/v1/models with your key for the current
# catalog before assuming it's a code bug.
# Type    : string
# Default : openai/gpt-oss-120b
# Required: no
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic API key — used only when LLM_PROVIDER=anthropic.
# Get it at: https://console.anthropic.com/settings/keys
# Format  : sk-ant-api03-...
# Type    : string
# Required: yes, when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-your-key

# Claude model to use for all agents when LLM_PROVIDER=anthropic.
# Type    : string
# Default : claude-haiku-4-5-20251001
# Required: no
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Maximum tokens per agent LLM call. Increase for longer Investment Memos.
# Type    : integer
# Default : 4096
# Required: no
ANTHROPIC_MAX_TOKENS=4096


# ── 3. Observability (LangSmith) ─────────────────────────────────────────────

# LangSmith API key — traces every agent call with latency and token data.
# Get it at: https://smith.langchain.com/settings
# Format  : ls__...
# Type    : string
# Required: no (tracing is disabled entirely if absent)
LANGSMITH_API_KEY=ls__replace-with-your-key

# Enables LangChain/LangGraph tracing to LangSmith. Effective only when
# LANGSMITH_API_KEY is also set (backend.config.Settings.tracing_enabled
# requires both).
# Type    : boolean string
# Default : true
# Required: no
LANGCHAIN_TRACING_V2=true

# LangSmith project name. Traces are grouped under this project.
# Use different names per environment (airp-dev, airp-staging, airp-prod).
# Type    : string
# Default : airp-dev
# Required: no
LANGCHAIN_PROJECT=airp-dev

# LangSmith endpoint. Only change if using a self-hosted LangSmith instance.
# Type    : string (URL)
# Default : https://api.smith.langchain.com
# Required: no
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


# ── 4. Database (PostgreSQL — Neon) ──────────────────────────────────────────

# Primary database connection string.
# Local Docker  : postgresql+asyncpg://airp:airp@localhost:5432/airp
# Neon (cloud)  : postgresql+asyncpg://user:password@ep-xxx.neon.tech/airp?sslmode=require
# Get Neon URL  : https://console.neon.tech → your project → Connection Details
# Type    : string (SQLAlchemy async URL)
# Required: yes
DATABASE_URL=postgresql+asyncpg://airp:airp@localhost:5432/airp

# Separate test database URL — used when ENVIRONMENT=test.
# Must point to a different database than DATABASE_URL to prevent
# tests from touching development data.
# Type    : string (SQLAlchemy async URL)
# Required: yes (for running pytest)
DATABASE_TEST_URL=postgresql+asyncpg://airp:airp@localhost:5432/airp_test

# SQLAlchemy connection pool size.
# Type    : integer
# Default : 5
# Required: no
DB_POOL_SIZE=5

# Maximum overflow connections above pool size.
# Type    : integer
# Default : 10
# Required: no
DB_MAX_OVERFLOW=10


# ── 5. Cache (Redis — Upstash) ────────────────────────────────────────────────

# Redis connection URL.
# Local Docker   : redis://localhost:6379
# Upstash (cloud): rediss://default:password@host.upstash.io:6379
# Get Upstash URL: https://console.upstash.com → your database → REST API
# Type    : string (URL)
# Required: yes
REDIS_URL=redis://localhost:6379

# Upstash Redis token — only required when using Upstash cloud (used as
# the TLS/REST auth password by backend/db/redis_client.py).
# Not needed for local Docker Redis.
# Get it at: https://console.upstash.com → your database → REST API → token
# Type    : string
# Required: only for Upstash cloud (not local Docker)
REDIS_TOKEN=replace-with-upstash-token-if-using-cloud

# Cache TTLs in seconds — controls how long API responses are cached.
# Reducing these increases API call frequency (watch free tier limits).
# Type    : integer (seconds)
# Required: no
CACHE_TTL_STOCK=900          # 15 minutes — stock prices change frequently
CACHE_TTL_NEWS=3600          # 1 hour — news doesn't change that fast
CACHE_TTL_MACRO=86400        # 24 hours — macro data changes rarely
CACHE_TTL_FUNDAMENTALS=3600  # 1 hour — financial statements are stable


# ── 6. Vector Store (ChromaDB) ────────────────────────────────────────────────

# Enable ChromaDB-backed RAG (News Sentiment agent's semantic search over
# ingested articles). Defaults to True everywhere except production, where
# it defaults to False unless set explicitly here -- ChromaDB has no
# managed backing service on the free-tier deploy target (see render.yaml).
# Type    : boolean string
# Default : true (false in production)
# Required: no
FEATURE_RAG_ENABLED=true

# ChromaDB host. Points to the Docker container in local dev.
# Type    : string (hostname)
# Default : localhost
# Required: no
CHROMA_HOST=localhost

# ChromaDB port. Default ChromaDB port.
# Type    : integer
# Default : 8001 (mapped from container's 8000 in docker-compose)
# Required: no
CHROMA_PORT=8001

# ChromaDB collection name for storing news and earnings embeddings.
# Type    : string
# Default : airp_documents
# Required: no
CHROMA_COLLECTION=airp_documents

# Local sentence-transformers model name for generating embeddings.
# Runs locally — no API cost. Model downloads on first run (~90MB), lazily
# on first actual use (see backend/db/chroma_client.py's
# get_embedding_function), not at process start.
# Type    : string
# Default : all-MiniLM-L6-v2 (fast, good quality, 384 dimensions)
# Options : all-MiniLM-L6-v2 | all-mpnet-base-v2 (slower, higher quality)
# Required: no
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Override for the local-dev ChromaDB PersistentClient directory. Leave
# empty to use the default outside the repo root (~/.airp/chroma_data,
# backend/db/chroma_client.py's CHROMA_PERSIST_DIR) -- it must stay
# outside anything `uvicorn --reload` watches, or writes to it trigger
# reloads mid-analysis.
# Type    : string (path)
# Default : "" (uses ~/.airp/chroma_data)
# Required: no
CHROMA_PERSIST_DIR=


# ── 7. Authentication ─────────────────────────────────────────────────────────

# Shared secret required in the X-Service-Token header for
# POST /api/v1/accuracy/run (T-090). This endpoint is called by the
# scheduled .github/workflows/evaluate-verdicts.yml cron job, not by
# any logged-in user, so it is protected by this static token instead
# of the JWT auth every other route uses.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store the same value as the ACCURACY_SERVICE_TOKEN secret in the
# GitHub repo (Settings -> Secrets and variables -> Actions).
# Type    : string
# Required: yes, in any environment where the scheduled workflow runs
#           against it. Leaving this empty DISABLES the endpoint
#           entirely (every request is rejected with 401) -- the
#           dependency fails closed rather than accepting an
#           unauthenticated call when no secret is configured.
ACCURACY_SERVICE_TOKEN=replace-with-a-long-random-secret


# ── 8. External Data APIs ─────────────────────────────────────────────────────

# NewsAPI — fetches last 30 days of company news for the Sentiment Agent.
# Free tier: 100 requests/day. Cached for 1 hour in Redis.
# Get it at: https://newsapi.org/register
# Format  : 32-char hex string
# Type    : string
# Required: yes (Phase 1 — News Sentiment Agent)
NEWS_API_KEY=replace-with-your-newsapi-key

# Alpha Vantage — additional fundamentals and earnings data.
# Free tier: 25 requests/day. Use sparingly; Redis cache essential.
# Get it at: https://www.alphavantage.co/support/#api-key
# Format  : alphanumeric string
# Type    : string
# Required: yes (Phase 1 — Fundamental Analyst Agent)
ALPHA_VANTAGE_KEY=replace-with-your-alpha-vantage-key

# yFinance requires no API key — it is an unofficial Yahoo Finance scraper.
# Included here for documentation completeness. No value needed.
# Redis caching is still recommended to avoid rate limits.
# YFINANCE_API_KEY=not-required

# Screener.in — Indian stock peer comparison and financial ratios.
# Scraped directly (no official API). No key required.
# Type    : string (URL)
# Default : https://www.screener.in
SCREENER_BASE_URL=https://www.screener.in

# RBI data scraper base URL — used by the Macro Economist Agent.
# Type    : string (URL)
# Default : https://www.rbi.org.in
RBI_BASE_URL=https://www.rbi.org.in


# ── 9. Feature Flags ──────────────────────────────────────────────────────────
# Boolean flags to enable/disable features during development.
# Set to true/false. Evaluated as strings in Python (use == "true").

# Enable the multi-round debate loop. Set to false to run agents once
# without the adversarial debate round (faster, lower token cost for dev).
# Type    : boolean string
# Default : true
# Required: no
FEATURE_DEBATE_ENABLED=true

# Maximum number of debate rounds route_after_contrarian will run before
# forcing the pipeline to proceed to Risk Officer / Valuation.
# Type    : integer
# Default : 2
# Required: no
DEBATE_ROUNDS=2

# Enable PDF generation via WeasyPrint. Set to false to return JSON only
# during early development when the PDF template isn't ready yet.
# Type    : boolean string
# Default : true
# Required: no
FEATURE_PDF_ENABLED=true

# Directory where generated Investment Memo PDFs are written.
# Relative paths are resolved against the repository root. Created
# automatically if it does not exist. Ignored when ENVIRONMENT=test. Note
# that most PaaS filesystems (e.g. Render) are ephemeral across
# deploys/restarts -- files here do not persist long-term.
# Type    : string (path)
# Default : data/memos
# Required: no
MEMO_OUTPUT_DIR=data/memos

# Enable rate limiting on the FastAPI endpoints (in-process, per-client-IP
# fixed window -- see backend/services/rate_limiter.py). Set to false in
# development to avoid hitting limits during testing.
# Type    : boolean string
# Default : true
# Required: no
FEATURE_RATE_LIMITING=true

# Maximum requests per client (by IP) per rolling 60-second window when
# FEATURE_RATE_LIMITING is on. Requests over this get 429 Too Many
# Requests.
# Type    : integer
# Default : 60
# Required: no
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Maximum number of LangGraph analysis pipelines allowed to run
# concurrently, process-wide (not per-user) -- protects a
# memory-constrained single instance from thrashing/OOM. A caller beyond
# this limit gets 503 from POST /api/v1/analysis/start.
# Type    : integer
# Default : 3
# Required: no
MAX_CONCURRENT_ANALYSES=3

# Maximum accepted PDF upload size in megabytes for
# POST /api/v1/documents/upload. Requests above this are rejected with
# 413 before any text extraction is attempted.
# Type    : integer
# Default : 20
# Required: no
MAX_UPLOAD_SIZE_MB=20
