# frontend/nginx.conf.template
# =============================================================================
# AIRP — nginx config for the production frontend image (T-073)
#
# ${BACKEND_UPSTREAM} is substituted at container start by the official
# nginx image's docker-entrypoint (envsubst over every *.template file in
# /etc/nginx/templates/) — see frontend/Dockerfile's ENV BACKEND_UPSTREAM.
# =============================================================================

server {
    listen       80;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Static assets — Vite fingerprints filenames (e.g. index-4f2a9c.js),
    # so these are safe to cache aggressively; a new build ships new
    # filenames rather than invalidating old ones.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA client-side routing (React Router, T-053+): any path that
    # doesn't match a real file falls back to index.html so deep links
    # like /analysis/abc123 don't 404 on a hard refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # REST API — backend/main.py mounts analysis/documents/accuracy/chat
    # routers under /api/v1 (see backend/main.py's router registration).
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Auth — backend/routers/auth.py mounts at /auth, not under /api/v1
    # (same split the Vite dev proxy in vite.config.ts makes).
    location /auth/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket — WS /api/v1/analysis/{job_id}/stream (backend/routers/
    # websocket.py). Needs the Upgrade/Connection headers the two /api/
    # and /auth/ blocks above don't set, so it gets its own location.
    location /api/v1/analysis/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }
}
