# frontend/.env.example
# Copy to .env.local for local overrides. All frontend vars MUST be
# prefixed with VITE_ to be exposed to the client bundle.

# Base URL of the AIRP backend API.
# Leave UNSET in local dev: requests use the relative "/api/v1" path, which
# the Vite dev proxy (vite.config.ts) forwards to http://localhost:8000.
# Set in production (e.g. Vercel project settings):
# VITE_API_BASE_URL=https://airp-api.onrender.com/api/v1

# Base URL of the AIRP auth endpoints (T-056). Separate from
# VITE_API_BASE_URL because backend/routers/auth.py mounts at "/auth",
# not under "/api/v1" (see backend/main.py's router registration).
# Leave UNSET in local dev: requests use the relative "/auth" path, which
# the Vite dev proxy (vite.config.ts) forwards to http://localhost:8000.
# Set in production (e.g. Vercel project settings):
# VITE_AUTH_BASE_URL=https://airp-api.onrender.com/auth

# WebSocket base URL (T-074 audit finding C1). Leave UNSET in local dev:
# useAnalysisStream.ts / useChatStream.ts derive one from VITE_API_BASE_URL
# when that is absolute, and fall back to window.location (same-origin)
# when neither is set -- which is what makes local dev and any deployment
# where the frontend and backend share an origin work with no config at
# all. REQUIRED in production whenever the frontend and backend are on
# different hosts (e.g. Vercel + Render) -- without it, WebSocket
# connections would otherwise dial the frontend's own origin and 404,
# silently killing the live agent progress viewer, the live graph, the
# debate viewer, and chat streaming.
# VITE_WS_BASE_URL=wss://airp-api.onrender.com
