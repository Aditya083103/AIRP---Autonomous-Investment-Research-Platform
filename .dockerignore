# .dockerignore (repo root)
# =============================================================================
# AIRP — applies to `docker build -f backend/Dockerfile .` (T-073), whose
# build context is the repo root. Keeps the backend image lean and keeps
# irrelevant local state (Windows .venv, editor caches, uploaded secrets)
# from ever being COPYed into a layer.
# =============================================================================

# Version control / CI
.git
.github

# Not needed inside the backend image — separate build context/image
frontend

# Docs and planning artifacts — not runtime dependencies
docs
*.md
*.drawio
*.xlsx

# Local environment / secrets — real values come from docker-compose
# env_file / -e flags, never baked into an image layer
.env
.env.*
!.env.example

# Python virtual environments and caches
.venv
venv
__pycache__
*.pyc
*.pyo
.mypy_cache
.pytest_cache
.ruff_cache
htmlcov
.coverage
coverage.xml

# Backend test suite — not needed at runtime; kept out of the shipped
# image (requirements-dev.txt with pytest etc. is also never installed
# in backend/Dockerfile's runtime stage)
backend/tests

# Data generated by local runs
data
*.chroma_data
.chroma_data

# OS / editor cruft
.DS_Store
.vscode
.idea

# Docker files themselves don't need to be in the build context copy
Dockerfile*
docker-compose*.yml
